{{template "header"}}

{{template "username" .}}

{{if .switching}}

<div class="alert alert-success" role="alert">
    <h4 class="alert-heading">VLAN switched!</h4>
    <p>The change takes effect within a few minutes. If nothing happens after 5 minutes, unplug and replug your cable.</p>
</div>

<div class="d-flex justify-content-center mt-2">
    <form action="/">
        <button type="submit" class="btn btn-primary btn-lg">OK</button>
    </form>
</div>

{{else if .connecting}}

<div class="alert alert-success" role="alert">
    <h4 class="alert-heading">Connected!</h4>
    <p>You should have internet access within a few minutes. If nothing happens after 5 minutes, unplug and replug your cable.</p>
</div>

<div class="d-flex justify-content-center mt-2">
    <form action="/">
        <button type="submit" class="btn btn-primary btn-lg">OK</button>
    </form>
</div>

{{else}}

<div class="alert alert-success" role="alert">
    <h4 class="alert-heading">Disconnected.</h4>
    <p>You have been moved back to the logon VLAN.</p>
</div>

<div class="d-flex flex-column align-items-center gap-3 mt-2">
    <form action="/connect">
        <button type="submit" class="btn btn-primary btn-lg">Connect again</button>
    </form>
    <form action="/logout">
        <button type="submit" class="btn btn-outline-secondary btn-lg">Log out</button>
    </form>
</div>

{{end}}

{{template "footer"}}
