{{template "header"}}

{{template "username" .}}

{{/* Shown while the port is bounced. Revealed by the script below; without JS the <noscript> message is shown instead. */}}
<div id="pending" class="d-none" data-status-url="/status">
    <div class="spinner-border text-danger my-3" role="status" style="width: 4rem; height: 4rem;">
        <span class="visually-hidden">Loading...</span>
    </div>
    <h4>{{if .switching}}Switching VLAN...{{else if .connecting}}Connecting...{{else}}Disconnecting...{{end}}</h4>
    <p>Your connection will drop briefly while the switch port is reset. Please keep this page open.</p>
</div>

<div id="timeout" class="d-none">
    <div class="alert alert-warning" role="alert">
        <h4 class="alert-heading">Taking longer than expected</h4>
        <p class="mb-0">We could not confirm that you are in the new network yet. Unplug and replug your cable. If that does not help, contact the support.</p>
    </div>
    <div class="d-flex justify-content-center mt-2">
        <form action="/">
            <button type="submit" class="btn btn-primary btn-lg">OK</button>
        </form>
    </div>
</div>

<noscript>
    <div class="alert alert-success" role="alert">
        <h4 class="alert-heading">{{if .switching}}VLAN switch requested.{{else if .connecting}}Connection requested.{{else}}Disconnect requested.{{end}}</h4>
        <p>Your connection will drop briefly and the change takes effect within a few minutes. If nothing happens after 5 minutes, unplug and replug your cable.</p>
    </div>
    <div class="d-flex justify-content-center mt-2">
        <form action="/">
            <button type="submit" class="btn btn-primary btn-lg">OK</button>
        </form>
    </div>
</noscript>

{{/* Final state, revealed once the client has arrived in the new VLAN. */}}
<div id="done" class="d-none">
{{if .switching}}

<div class="alert alert-success" role="alert">
    <h4 class="alert-heading">VLAN switched!</h4>
    <p>You are now connected to the new VLAN.</p>
</div>

<div class="d-flex justify-content-center mt-2">
    <form action="/">
        <button type="submit" class="btn btn-primary btn-lg">OK</button>
    </form>
</div>

{{else if .connecting}}

<div class="alert alert-success" role="alert">
    <h4 class="alert-heading">Connected!</h4>
    <p>You are now on the network and should have internet access.</p>
</div>

<div class="d-flex justify-content-center mt-2">
    <form action="/">
        <button type="submit" class="btn btn-primary btn-lg">OK</button>
    </form>
</div>

{{else}}

<div class="alert alert-success" role="alert">
    <h4 class="alert-heading">Disconnected.</h4>
    <p>You are back in the logon network. Connect again to get internet access.</p>
</div>

<div class="d-flex flex-column align-items-center gap-3 mt-2">
    <form action="/connect">
        <button type="submit" class="btn btn-primary btn-lg">Connect again</button>
    </form>
    <form action="/logout">
        <button type="submit" class="btn btn-outline-secondary btn-lg">Log out</button>
    </form>
</div>

{{end}}
</div>

<script>
(function () {
    var pending = document.getElementById('pending');
    var done = document.getElementById('done');
    var timeout = document.getElementById('timeout');
    var statusURL = pending.getAttribute('data-status-url');

    var POLL_INTERVAL_MS = 2000;
    var REQUEST_TIMEOUT_MS = 4000;
    var GIVE_UP_AFTER_MS = 5 * 60 * 1000;
    var startedAt = Date.now();

    function show(el) {
        pending.classList.add('d-none');
        done.classList.add('d-none');
        timeout.classList.add('d-none');
        el.classList.remove('d-none');
    }

    function schedule() {
        if (Date.now() - startedAt > GIVE_UP_AFTER_MS) {
            show(timeout);
            return;
        }
        setTimeout(poll, POLL_INTERVAL_MS);
    }

    // While the port is bounced the client has no network at all, so failed or
    // hanging requests are expected and simply mean "not there yet".
    function poll() {
        var controller = new AbortController();
        var abort = setTimeout(function () { controller.abort(); }, REQUEST_TIMEOUT_MS);
        fetch(statusURL, { cache: 'no-store', credentials: 'same-origin', signal: controller.signal })
            .then(function (resp) {
                if (resp.status === 404) {
                    // nothing to wait for (e.g. session without a pending switch)
                    show(done);
                    return;
                }
                if (!resp.ok) { throw new Error('status ' + resp.status); }
                return resp.json().then(function (body) {
                    if (body.connected) { show(done); } else { schedule(); }
                });
            })
            .catch(schedule)
            .finally(function () { clearTimeout(abort); });
    }

    show(pending);
    setTimeout(poll, POLL_INTERVAL_MS);
})();
</script>

{{template "footer"}}
